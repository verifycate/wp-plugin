{
	"name": "verifycate/wp-plugin",
	"description": "Issue verifiable certificates from your WordPress LMS with Verifycate.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"lms",
		"certificates",
		"learndash",
		"tutor-lms",
		"learnpress",
		"lifterlms",
		"verifycate"
	],
	"homepage": "https://github.com/verifycate/wp-plugin",
	"support": {
		"issues": "https://github.com/verifycate/wp-plugin/issues",
		"source": "https://github.com/verifycate/wp-plugin"
	},
	"authors": [
		{
			"name": "Verifycate",
			"homepage": "https://verifycate.com"
		}
	],
	"repositories": [
		{
			"type": "path",
			"url": "../php-sdk",
			"options": {
				"symlink": false,
				"versions": {
					"verifycate/php-sdk": "0.1.0"
				}
			}
		}
	],
	"require": {
		"php": ">=7.4",
		"verifycate/php-sdk": "^0.1"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.2",
		"yoast/phpunit-polyfills": "^3.0"
	},
	"autoload": {
		"psr-4": {
			"Verifycate\\": "src/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "7.4.33"
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"test": "phpunit",
		"check": [
			"@lint",
			"@analyse",
			"@test"
		],
		"build": "bash bin/build-plugin.sh"
	}
}
