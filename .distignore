# Files excluded from the distributed plugin zip (wordpress.org).
#
# Runtime dependencies are installed with `composer install --no-dev` and the
# Verifycate PHP SDK lives in vendor/. `bin/build-plugin.sh` uses this file with
# rsync and then zips the result.

.git
.github
.wordpress-org
bin
build
node_modules
tests
composer.json
composer.lock
package.json
package-lock.json
pnpm-lock.yaml
phpcs.xml.dist
phpstan.neon.dist
phpunit.xml.dist
wp-env.json
.distignore
.svnignore
.gitignore
.gitattributes
.editorconfig
.phpunit.result.cache
.phpunit.cache
CODE_OF_CONDUCT.md
CONTRIBUTING.md
README.md
SECURITY.md

# Trim the bundled SDK to its runtime files.
vendor/verifycate/php-sdk/tests
vendor/verifycate/php-sdk/openapi
vendor/verifycate/php-sdk/scripts
vendor/verifycate/php-sdk/vendor
vendor/verifycate/php-sdk/.git
vendor/verifycate/php-sdk/.github
vendor/verifycate/php-sdk/.editorconfig
vendor/verifycate/php-sdk/.gitignore
vendor/verifycate/php-sdk/phpcs.xml.dist
vendor/verifycate/php-sdk/phpstan.neon.dist
vendor/verifycate/php-sdk/phpunit.xml.dist
vendor/verifycate/php-sdk/README.md
vendor/verifycate/php-sdk/CHANGELOG.md
vendor/verifycate/php-sdk/CONTRIBUTING.md
vendor/verifycate/php-sdk/SECURITY.md
vendor/verifycate/php-sdk/composer.json
